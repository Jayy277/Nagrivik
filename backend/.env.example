# Nagrivic Backend Environment Variables Template
# Copy this file to .env or set these environment variables in your environment

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=default

# PostgreSQL + PostGIS Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nagrivic
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
JPA_DDL_AUTO=none
HIBERNATE_FORMAT_SQL=true

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://*
