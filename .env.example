# Nagrivic Monorepo Environment Variables Template
# Copy this file to .env for local development

# PostgreSQL + PostGIS Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nagrivic
DB_USERNAME=nagrivic
DB_PASSWORD=nagrivic_dev_secret
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Backend Service
PORT=8080
SPRING_PROFILES_ACTIVE=default
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate
HIBERNATE_FORMAT_SQL=true

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://*

# Authentication (Task 33 - Google Primary Sign-In)
# Backend: Comma-separated allowlist of authorized Google OAuth Client IDs (Web, Android, iOS)
GOOGLE_CLIENT_IDS=nagrivic-dev-web-client-id,nagrivic-dev-android-client-id,nagrivic-dev-ios-client-id

# Web (Next.js): Server-side Google OAuth client ID and confidential secret
GOOGLE_WEB_CLIENT_ID=nagrivic-dev-web-client-id
GOOGLE_WEB_CLIENT_SECRET=change_in_production_keep_secret_server_side_only
NEXT_PUBLIC_GOOGLE_CLIENT_ID=nagrivic-dev-web-client-id

# Mobile (React Native / Expo): Public Google OAuth client ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=nagrivic-dev-web-client-id

# Object Storage Foundation (Task 49 - Local & S3-Compatible)
# STORAGE_PROVIDER: 'local' (default) or 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=build/uploads

# S3-Compatible Storage (AWS S3, MinIO, Cloudflare R2, LocalStack)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=nagrivic-media
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PATH_STYLE_ACCESS=false
STORAGE_S3_CONNECTION_TIMEOUT_MS=10000

# Push Notifications (Task 50 - Firebase Cloud Messaging)
# FCM_ENABLED: false (default for offline dev & tests) or true (production/staging)
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=

