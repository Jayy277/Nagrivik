# Nagrivic Monorepo Environment Variables Template
# Copy this file to .env for local development

# PostgreSQL + PostGIS Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nagrivic
DB_USERNAME=nagrivic
DB_PASSWORD=nagrivic_dev_secret
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Backend Service
PORT=8080
SPRING_PROFILES_ACTIVE=default
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate
HIBERNATE_FORMAT_SQL=true

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://*
